{
  "dataset": {
    "name": "retrieve-arxiv-large-cagra-g64-ig128",
    "base_file": "arxiv-for-fanns-large/base.fbin",
    "query_file": "arxiv-for-fanns-large/query.fbin",
    "distance": "euclidean",
    "dtype": "float"
  },
  "search_basic_param": {
    "batch_size": 1000,
    "k": 10
  },
  "index": [
    {
      "name": "cagra-g64-ig128",
      "algo": "cuvs_cagra",
      "file": "arxiv-for-fanns-large/cagra_g64_ig128.index",
      "build_param": {
        "graph_build_algo": "NN_DESCENT",
        "graph_degree": 64,
        "intermediate_graph_degree": 128,
        "nn_descent_max_iterations": 20,
        "nn_descent_termination_threshold": 0.0001
      },
      "search_params": [
        {
          "algo": "single_cta",
          "itopk": 64,
          "search_width": 1
        }
      ]
    }
  ]
}
