template <>
CUVS_EXPORT void benchmark_search_udf_with_result_accumulator<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  const float* filtering_rates,
  bool passing_accumulator)
{
  auto const* udf_filter =
    dynamic_cast<cuvs::neighbors::filtering::udf_filter const*>(&sample_filter);
  RAFT_EXPECTS(udf_filter != nullptr, "UDF result accumulation requires a UDF filter");
  RAFT_EXPECTS(params.filter_mode == filtering_mode::DEFAULT,
               "FAVOR is retired. Use Base, Retain, or NaviX.");
  RAFT_EXPECTS((params.algo == search_algo::AUTO || params.algo == search_algo::SINGLE_CTA) &&
                 !params.persistent,
               "UDF result accumulation requires non-persistent SINGLE_CTA search");
  RAFT_EXPECTS(filtering_rates == nullptr, "CAGRA must not receive UDF selectivity estimates");
  auto params_copy = params;
  params_copy.algo = search_algo::SINGLE_CTA;
  if (params_copy.filtering_rate < 0.0f) {
    params_copy.filtering_rate = udf_filter->filtering_rate < 0.0f
                                  ? 0.0f
                                  : std::clamp(udf_filter->filtering_rate, 0.0f, 0.999f);
  }
  auto run_with_policy = [&]<bool PassingAccumulator>() {
    using runtime_t =
      CagraSampleFilterWithRuntimeState<cuvs::neighbors::filtering::udf_filter, PassingAccumulator>;
    auto runtime_filter = runtime_t{*udf_filter, nullptr};
    search_with_filtering<data_t, std::uint32_t, runtime_t, std::int64_t>(
      res, params_copy, index, queries, neighbors, distances, runtime_filter);
  };
  if (passing_accumulator) { run_with_policy.template operator()<true>(); }
  else { run_with_policy.template operator()<false>(); }
}

template <>
CUVS_EXPORT void benchmark_search_navix_udf<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  std::uint32_t navix_policy)
{
  auto const* udf_filter =
    dynamic_cast<cuvs::neighbors::filtering::udf_filter const*>(&sample_filter);
  RAFT_EXPECTS(udf_filter != nullptr, "benchmark_search_navix_udf requires a UDF filter");
  const auto graph_degree = index.graph().extent(1);
  RAFT_EXPECTS(graph_degree == 32 || graph_degree == 64,
               "NaviX currently requires a degree-32 or degree-64 CAGRA graph");

  auto params_copy           = params;
  params_copy.algo           = search_algo::SINGLE_CTA;
  params_copy.persistent     = false;
  params_copy.filter_mode    = filtering_mode::DEFAULT;
  params_copy.filtering_rate = 0.0f;
  using runtime_filter_t =
    CagraSampleFilterWithNavixRuntimeState<cuvs::neighbors::filtering::udf_filter>;
  auto runtime_filter = runtime_filter_t{*udf_filter, navix_policy};
  search_with_filtering<data_t, std::uint32_t, runtime_filter_t, std::int64_t>(
    res, params_copy, index, queries, neighbors, distances, runtime_filter);
}

template <typename BitmapFilterT>
auto validate_navix_bitmap(
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  std::uint32_t query_offset) -> BitmapFilterT const&
{
  auto const* bitmap = dynamic_cast<BitmapFilterT const*>(&sample_filter);
  RAFT_EXPECTS(bitmap != nullptr, "benchmark bitmap search requires a uint32 bitmap filter");
  const auto graph_degree = index.graph().extent(1);
  RAFT_EXPECTS(graph_degree == 32 || graph_degree == 64,
               "NaviX currently requires a degree-32 or degree-64 CAGRA graph");
  RAFT_EXPECTS(query_offset + static_cast<std::uint64_t>(queries.extent(0)) <=
                 static_cast<std::uint64_t>(bitmap->view().get_n_rows()),
               "benchmark bitmap does not cover the requested query range");
  RAFT_EXPECTS(bitmap->view().get_n_cols() >= static_cast<std::int64_t>(index.size()),
               "benchmark bitmap has fewer source columns than CAGRA nodes");
  return *bitmap;
}

template <>
CUVS_EXPORT void benchmark_search_bitmap_with_query_offset<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  std::uint32_t query_offset,
  bool passing_accumulator)
{
  using bitmap_t     = cuvs::neighbors::filtering::bitmap_filter<std::uint32_t, std::int64_t>;
  auto const& bitmap = validate_navix_bitmap<bitmap_t>(index, queries, sample_filter, query_offset);
  auto params_copy   = params;
  params_copy.algo   = search_algo::SINGLE_CTA;
  params_copy.persistent     = false;
  params_copy.filter_mode    = filtering_mode::DEFAULT;
  params_copy.filtering_rate = 0.0f;
  if (passing_accumulator) {
    using accumulator_t = CagraSampleFilterWithRuntimeState<bitmap_t, true>;
    using runtime_t     = CagraSampleFilterWithBaseQueryIdOffset<accumulator_t>;
    auto runtime        = runtime_t{accumulator_t{bitmap, nullptr}, query_offset};
    search_with_filtering<data_t, std::uint32_t, runtime_t, std::int64_t>(
      res, params_copy, index, queries, neighbors, distances, runtime);
  } else {
    using runtime_t = CagraSampleFilterWithBaseQueryIdOffset<bitmap_t>;
    auto runtime    = runtime_t{bitmap, query_offset};
    search_with_filtering<data_t, std::uint32_t, runtime_t, std::int64_t>(
      res, params_copy, index, queries, neighbors, distances, runtime);
  }
}

template <>
CUVS_EXPORT void benchmark_search_bitmap_seeded<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  std::uint32_t query_offset,
  std::uint32_t* seed_ids,
  std::uint32_t* seed_counts,
  std::uint32_t* inspected_units,
  bool passing_accumulator,
  std::uint32_t seed_stride)
{
  using bitmap_t = cuvs::neighbors::filtering::bitmap_filter<std::uint32_t, std::int64_t>;
  RAFT_EXPECTS(params.algo == search_algo::SINGLE_CTA,
               "benchmark_search_bitmap_seeded requires SINGLE_CTA");
  RAFT_EXPECTS(!params.persistent,
               "benchmark_search_bitmap_seeded does not support persistent search");
  RAFT_EXPECTS(params.filter_mode == filtering_mode::DEFAULT,
               "benchmark_search_bitmap_seeded requires default filtering mode");
  RAFT_EXPECTS(seed_ids != nullptr && seed_counts != nullptr,
               "benchmark_search_bitmap_seeded requires seed ID and count buffers");
  auto const& bitmap = validate_navix_bitmap<bitmap_t>(index, queries, sample_filter, query_offset);
  const auto num_queries = static_cast<std::uint32_t>(queries.extent(0));
  if (seed_stride == 0) { seed_stride = static_cast<std::uint32_t>(neighbors.extent(1)); }
  RAFT_EXPECTS(seed_stride > 0, "benchmark_search_bitmap_seeded requires a positive seed stride");
  const auto source_indices = index.source_indices();
  select_navix_bitmap_seeds(res,
                            bitmap,
                            source_indices ? source_indices->data_handle() : nullptr,
                            query_offset,
                            num_queries,
                            static_cast<std::uint32_t>(index.size()),
                            seed_stride,
                            seed_ids,
                            seed_counts,
                            inspected_units);

  auto params_copy           = params;
  params_copy.algo           = search_algo::SINGLE_CTA;
  params_copy.persistent     = false;
  params_copy.filter_mode    = filtering_mode::DEFAULT;
  params_copy.filtering_rate = 0.0f;

  auto run_with_policy = [&]<bool PassingAccumulator>() {
    using policy_t  = CagraSampleFilterWithRuntimeState<bitmap_t, PassingAccumulator>;
    using seeded_t  = CagraSampleFilterWithBitmapSeedRuntimeState<policy_t>;
    using runtime_t = CagraSampleFilterWithBaseQueryIdOffset<seeded_t>;
    auto runtime    = runtime_t{
      seeded_t{policy_t{bitmap, nullptr}, seed_ids, seed_counts, seed_stride}, query_offset};
    search_with_filtering<data_t, std::uint32_t, runtime_t, std::int64_t>(
      res, params_copy, index, queries, neighbors, distances, runtime);
  };
  if (passing_accumulator) {
    run_with_policy.template operator()<true>();
  } else {
    run_with_policy.template operator()<false>();
  }
}

template <>
CUVS_EXPORT void benchmark_search_navix_bitmap<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  std::uint32_t query_offset,
  std::uint32_t navix_policy)
{
  using bitmap_t     = cuvs::neighbors::filtering::bitmap_filter<std::uint32_t, std::int64_t>;
  auto const& bitmap = validate_navix_bitmap<bitmap_t>(index, queries, sample_filter, query_offset);
  auto params_copy   = params;
  params_copy.algo   = search_algo::SINGLE_CTA;
  params_copy.persistent     = false;
  params_copy.filter_mode    = filtering_mode::DEFAULT;
  params_copy.filtering_rate = 0.0f;
  using navix_t              = CagraSampleFilterWithNavixRuntimeState<bitmap_t>;
  using runtime_t            = CagraSampleFilterWithBaseQueryIdOffset<navix_t>;
  auto runtime               = runtime_t{navix_t{bitmap, navix_policy}, query_offset};
  search_with_filtering<data_t, std::uint32_t, runtime_t, std::int64_t>(
    res, params_copy, index, queries, neighbors, distances, runtime);
}

template <>
CUVS_EXPORT void benchmark_search_navix_bitmap_seeded<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  std::uint32_t query_offset,
  std::uint32_t* seed_ids,
  std::uint32_t* seed_counts,
  std::uint32_t* inspected_units,
  std::uint32_t seed_stride,
  std::uint32_t navix_policy)
{
  using bitmap_t     = cuvs::neighbors::filtering::bitmap_filter<std::uint32_t, std::int64_t>;
  auto const& bitmap = validate_navix_bitmap<bitmap_t>(index, queries, sample_filter, query_offset);
  const auto num_queries = static_cast<std::uint32_t>(queries.extent(0));
  RAFT_EXPECTS(seed_stride > 0, "NaviX bitmap seed stride must be positive");
  constexpr std::size_t warp_size = 32;
  const auto configured_itopk =
    std::max<std::size_t>(params.itopk_size, static_cast<std::size_t>(neighbors.extent(1)));
  const auto aligned_itopk = ((configured_itopk + warp_size - 1) / warp_size) * warp_size;
  const auto seed_capacity = aligned_itopk + params.search_width * index.graph().extent(1);
  RAFT_EXPECTS(seed_stride <= seed_capacity,
               "NaviX bitmap seed stride %u exceeds SINGLE_CTA initialization capacity %zu",
               seed_stride,
               seed_capacity);
  const auto source_indices = index.source_indices();
  select_navix_bitmap_seeds(res,
                            bitmap,
                            source_indices ? source_indices->data_handle() : nullptr,
                            query_offset,
                            num_queries,
                            static_cast<std::uint32_t>(index.size()),
                            seed_stride,
                            seed_ids,
                            seed_counts,
                            inspected_units);

  auto params_copy           = params;
  params_copy.algo           = search_algo::SINGLE_CTA;
  params_copy.persistent     = false;
  params_copy.filter_mode    = filtering_mode::DEFAULT;
  params_copy.filtering_rate = 0.0f;
  using navix_t              = CagraSampleFilterWithNavixRuntimeState<bitmap_t>;
  using runtime_t            = CagraSampleFilterWithBaseQueryIdOffset<navix_t>;
  auto runtime =
    runtime_t{navix_t{bitmap, navix_policy, seed_ids, seed_counts, seed_stride}, query_offset};
  search_with_filtering<data_t, std::uint32_t, runtime_t, std::int64_t>(
    res, params_copy, index, queries, neighbors, distances, runtime);
}

}  // namespace cuvs::neighbors::cagra::detail
