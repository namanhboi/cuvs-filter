#include <cuvs/neighbors/cagra.hpp>
#include <neighbors/cagra.cuh>
#include <neighbors/cagra_benchmark.hpp>

#include <algorithm>

namespace {

using data_t = @data_type@;

}

namespace cuvs::neighbors::cagra {

#define CUVS_INST_CAGRA_SEARCH(T, IdxT, OutputIdxT)                                     \
  void search(raft::resources const& handle,                                            \
              cuvs::neighbors::cagra::search_params const& params,                      \
              const cuvs::neighbors::cagra::index<T, IdxT>& index,                      \
              raft::device_matrix_view<const T, int64_t, raft::row_major> queries,      \
              raft::device_matrix_view<OutputIdxT, int64_t, raft::row_major> neighbors, \
              raft::device_matrix_view<float, int64_t, raft::row_major> distances,      \
              const cuvs::neighbors::filtering::base_filter& sample_filter)             \
  {                                                                                     \
    cuvs::neighbors::cagra::search<T, IdxT, OutputIdxT>(                                \
      handle, params, index, queries, neighbors, distances, sample_filter);             \
  }

CUVS_INST_CAGRA_SEARCH(data_t, uint32_t, uint32_t);
CUVS_INST_CAGRA_SEARCH(data_t, uint32_t, int64_t);

#undef CUVS_INST_CAGRA_SEARCH

}  // namespace cuvs::neighbors::cagra

namespace cuvs::neighbors::cagra::detail {

template <>
CUVS_EXPORT std::uint64_t benchmark_count_favor_bitset_matches<data_t>(
  raft::resources const& res,
  cagra::index<data_t, std::uint32_t> const& index,
  cuvs::neighbors::filtering::base_filter const& sample_filter)
{
  using bitset_filter_type = cuvs::neighbors::filtering::bitset_filter<std::uint32_t, std::int64_t>;
  auto const* bitset_filter = dynamic_cast<bitset_filter_type const*>(&sample_filter);
  RAFT_EXPECTS(bitset_filter != nullptr,
               "benchmark_count_favor_bitset_matches requires a uint32 bitset filter");
  return count_favor_bitset_matches(res, index, *bitset_filter);
}

template <>
CUVS_EXPORT void benchmark_search_favor_with_known_filtering_rate<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter)
{
  using bitset_filter_type = cuvs::neighbors::filtering::bitset_filter<std::uint32_t, std::int64_t>;
  auto const* bitset_filter = dynamic_cast<bitset_filter_type const*>(&sample_filter);
  RAFT_EXPECTS(bitset_filter != nullptr,
               "benchmark_search_favor_with_known_filtering_rate requires a uint32 bitset filter");
  RAFT_EXPECTS(params.filter_mode == filtering_mode::FAVOR,
               "benchmark_search_favor_with_known_filtering_rate requires FAVOR mode");
  RAFT_EXPECTS(params.filtering_rate >= 0.0f && params.filtering_rate < 1.0f,
               "benchmark_search_favor_with_known_filtering_rate requires a known filtering rate");
  auto bitset_filter_copy = *bitset_filter;
  search_with_filtering<data_t, std::uint32_t, bitset_filter_type, std::int64_t>(
    res, params, index, queries, neighbors, distances, bitset_filter_copy);
}

template <>
CUVS_EXPORT void benchmark_estimate_favor_udf_filtering_rates<data_t>(
  raft::resources const& res,
  cagra::index<data_t, std::uint32_t> const& index,
  std::uint32_t num_queries,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  float* filtering_rates,
  std::uint32_t* passing_counts,
  std::uint32_t sample_offset)
{
  auto const* udf_filter =
    dynamic_cast<cuvs::neighbors::filtering::udf_filter const*>(&sample_filter);
  RAFT_EXPECTS(udf_filter != nullptr,
               "benchmark_estimate_favor_udf_filtering_rates requires a UDF filter");
  estimate_favor_udf_filtering_rates_into(
    res, index, num_queries, *udf_filter, filtering_rates, passing_counts, sample_offset);
}

template <>
CUVS_EXPORT void benchmark_search_favor_udf_with_sampled_rates<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  const float* filtering_rates,
  bool passing_accumulator)
{
  auto const* udf_filter =
    dynamic_cast<cuvs::neighbors::filtering::udf_filter const*>(&sample_filter);
  RAFT_EXPECTS(udf_filter != nullptr,
               "benchmark_search_favor_udf_with_sampled_rates requires a UDF filter");
  RAFT_EXPECTS(
    filtering_rates != nullptr || params.filter_mode == filtering_mode::DEFAULT,
    "benchmark_search_favor_udf_with_sampled_rates requires sampled rates or filter_mode=DEFAULT");

  auto params_copy = params;
  if (params.filter_mode == filtering_mode::FAVOR) {
    RAFT_EXPECTS((params.algo == search_algo::AUTO || params.algo == search_algo::SINGLE_CTA) &&
                   !params.persistent &&
                   params.favor_penalty == favor_penalty_mode::CAGRA_RETENTION_SAFE &&
                   params.favor_retention_fraction == 0.0f,
                 "benchmark_search_favor_udf_with_sampled_rates requires single-CTA retention-safe "
                 "UDF mode (AUTO or SINGLE_CTA)");
    params_copy.algo           = search_algo::SINGLE_CTA;
    params_copy.filtering_rate = 0.0f;
  } else {
    RAFT_EXPECTS(
      params.filter_mode == filtering_mode::DEFAULT,
      "benchmark_search_favor_udf_with_sampled_rates supports DEFAULT and FAVOR filter modes");
    RAFT_EXPECTS((params.algo == search_algo::AUTO || params.algo == search_algo::SINGLE_CTA) &&
                   !params.persistent,
                 "default UDF passing accumulation supports only non-persistent SINGLE_CTA "
                 "search (AUTO or SINGLE_CTA)");
    RAFT_EXPECTS(filtering_rates == nullptr,
                 "default CAGRA must not receive UDF selectivity estimates");
    params_copy.algo = search_algo::SINGLE_CTA;
    if (params_copy.filtering_rate < 0.0f) {
      constexpr float min_filtering_rate = 0.0f;
      constexpr float max_filtering_rate = 0.999f;
      params_copy.filtering_rate =
        udf_filter->filtering_rate < 0.0f
          ? 0.0f
          : std::min(std::max(udf_filter->filtering_rate, min_filtering_rate), max_filtering_rate);
    }
  }

  auto run_with_policy = [&]<bool PassingAccumulator>() {
    using runtime_filter_t =
      CagraSampleFilterWithRuntimeState<cuvs::neighbors::filtering::udf_filter, PassingAccumulator>;
    auto runtime_filter = runtime_filter_t{*udf_filter, filtering_rates};
    search_with_filtering<data_t, std::uint32_t, runtime_filter_t, std::int64_t>(
      res, params_copy, index, queries, neighbors, distances, runtime_filter);
  };
  if (passing_accumulator) {
    run_with_policy.template operator()<true>();
  } else {
    run_with_policy.template operator()<false>();
  }
}

template <>
CUVS_EXPORT void benchmark_search_navix_udf<data_t>(
  raft::resources const& res,
  cagra::search_params const& params,
  cagra::index<data_t, std::uint32_t> const& index,
  raft::device_matrix_view<const data_t, std::int64_t, raft::row_major> queries,
  raft::device_matrix_view<std::int64_t, std::int64_t, raft::row_major> neighbors,
  raft::device_matrix_view<float, std::int64_t, raft::row_major> distances,
  cuvs::neighbors::filtering::base_filter const& sample_filter,
  std::uint32_t navix_policy)
{
  auto const* udf_filter =
    dynamic_cast<cuvs::neighbors::filtering::udf_filter const*>(&sample_filter);
  RAFT_EXPECTS(udf_filter != nullptr, "benchmark_search_navix_udf requires a UDF filter");
  RAFT_EXPECTS(index.graph().extent(1) == 32, "NaviX currently requires a degree-32 CAGRA graph");

  auto params_copy           = params;
  params_copy.algo           = search_algo::SINGLE_CTA;
  params_copy.persistent     = false;
  params_copy.filter_mode    = filtering_mode::DEFAULT;
  params_copy.filtering_rate = 0.0f;
  using runtime_filter_t =
    CagraSampleFilterWithNavixRuntimeState<cuvs::neighbors::filtering::udf_filter>;
  auto runtime_filter = runtime_filter_t{*udf_filter, navix_policy};
  search_with_filtering<data_t, std::uint32_t, runtime_filter_t, std::int64_t>(
    res, params_copy, index, queries, neighbors, distances, runtime_filter);
}

}  // namespace cuvs::neighbors::cagra::detail
